{
    "_meta": {
        "version": "1.0.0",
        "description": "GPR-FDA Pipeline Settings Template",
        "author": "Yunkai Sun (C-STEEL, CSE, ANL)",
        "notes": "Copy this template to your dataset folder and customize as needed."
    },
    "output_structure": {
        "base_output_dir": "_output",
        "pip2_individual_gpr": "individual_GPR",
        "pip3_scoring_aggregations": "summary_gpr",
        "pip4_efficiency_eval": "learning_curve",
        "pip5_batch_testing": "batch_testing"
    },
    "pip0_dataloading": {
        "file_extension": ".cor",
        "filename_parsing": {
            "delimiter": "_",
            "grouping_keys": [
                {
                    "name": "potential",
                    "token_index": 0,
                    "dtype": "float",
                    "regex_extract": "^([+-]?\\d+\\.?\\d*)V$",
                    "description": "Applied potential in Volts (e.g., -1.95V → -1.95)"
                },
                {
                    "name": "pH",
                    "token_index": 1,
                    "dtype": "float",
                    "regex_extract": "^pH(\\d+\\.?\\d*)$",
                    "description": "Solution pH value (e.g., pH1.48 → 1.48)"
                }
            ],
            "metadata_keys": [
                {
                    "name": "electrolyte",
                    "token_index": 2,
                    "dtype": "string",
                    "description": "Electrolyte type (e.g., Na2SO4)"
                }
            ]
        },
        "primary_grouping_key": "potential",
        "fallback_to_file_content": false
    },
    "pip1_datapreprocessing": {
        "column_names": {
            "x_col": "T (Seconds)",
            "y_col": "I (A/cm2)"
        },
        "filtering": {
            "enable_filtering": true,
            "max_points_set": 500,
            "min_x_cap": 1e-4,
            "max_x_cap": 1e4,
            "min_curve_range": 60.0,
            "y_threshold": 0.01
        },
        "x_scaling": {
            "method": "log",
            "params": {
                "base": "log10",
                "shift": 1e-9
            }
        },
        "y_scaling": {
            "method": "middle_average",
            "params": {
                "start_fraction": 0.5,
                "end_fraction": 0.9
            }
        },
        "grouping": {
            "group_round_digits": 2
        }
    },
    "pip2_individual_gpr": {
        "gpr_params": {
            "n_restarts_optimizer": 5,
            "alpha": 0.1,
            "normalize_y": true,
            "num_curves_threshold": 50,
            "num_X_pred_points_individual_default": 500,
            "num_X_pred_points_individual_high": 1000,
            "local_var_val_flag": true
        },
        "shared_grid": {
            "enabled": true,
            "method": "auto",
            "_method_options": ["auto", "explicit", "per_group"],
            "explicit_grid": "np.linspace(-3.0, 7.0, 500)",
            "_explicit_grid_note": "Python expression evaluated with numpy (np) available. Used when method='explicit'.",
            "auto_num_points": 500,
            "auto_padding_fraction": 0.0,
            "_auto_note": "When method='auto', grid is linspace(x_min, x_max, num_points) over all curves in group.",
            "refit_on_full_data": true,
            "_refit_note": "If true, after hyperparameter tuning on train split, refit GPR on all data with frozen hyperparams before regulating to shared grid."
        },
        "posterior_covariance": {
            "store_full_covariance": true,
            "storage_mode": "full",
            "_storage_mode_options": ["full", "diagonal", "sparse", "cholesky"],
            "sparse_threshold": 1e-6
        },
        "kernel": {
            "constant_bounds": [1e-2, 1e4],
            "matern_length_scale": 1.0,
            "matern_length_scale_bounds": [1e-2, 1e3],
            "matern_nu": 1.5,
            "white_noise_level": 1.0,
            "white_noise_bounds": [1e-12, 1e1]
        },
        "export": {
            "plot_individual_gpr": true,
            "individual_curve_alpha": 0.3,
            "plot_downsample_points": 500,
            "dpi": 150,
            "max_points_to_save": 10000
        }
    },
    "pip3_summary_gpr": {
        "file_pattern": "Individual_GPR_*.csv",
        "aggregation": {
            "weight_mode": "iterative",
            "_weight_mode_options": ["equal", "iterative"],
            "weight_scope": "curve",
            "_weight_scope_options": ["curve", "point"],
            "include_within_variance": true,
            "include_between_variance": true,
            "variance_aggregation_scale": "normalised",
            "_variance_aggregation_scale_options": ["real", "normalised"],
            "normalization_summary": true,
            "enable_operator_fusion": false,
            "_enable_operator_fusion_note": "Deprecated legacy comparison path. FGPR is the preferred covariance-aware method.",
            "enable_fgpr": true,
            "_enable_fgpr_note": "Enable functional GPR aggregation with between-curve covariance estimation.",
            "enable_student_t": true,
            "_enable_student_t_note": "Enable robust Student-t curve aggregation with iterative curvewise weights."
        },
        "plotting": {
            "plot_individual_gprs": true,
            "individual_curve_alpha": 0.20,
            "min_time_cap": 0.01
        },
        "hyperparams": {
            "max_iterations": null,
            "convergence_tol": 1e-6,
            "epsilon": 1e-12,
            "confidence_level": 0.95,
            "num_interp_points": 500,
            "_num_interp_points_note": "Used for iterative-weight interpolation, not for shared-grid regulated output.",
            "fgpr_min_scale_factor_ratio": 0.0,
            "_fgpr_min_scale_factor_ratio_note": "Exclude curves with |scale_factor| below this fraction of the median absolute scale factor. Set to 0 to disable.",
            "fgpr_structured_btw": false,
            "_fgpr_structured_btw_note": "Use a structured between-curve covariance model instead of a scalar diagonal contribution.",
            "student_t_nu": 5.0,
            "_student_t_nu_note": "Initial Student-t degrees of freedom. Smaller values give heavier tails.",
            "student_t_optimize_nu": true,
            "student_t_nu_bounds": [1.0, 500.0],
            "student_t_nu_lb_adaptive": false,
            "student_t_max_iterations": 100,
            "student_t_convergence_tol": 1e-6
        }
    },
    "pip4_efficiency_eval": {
        "global": {
            "metric": "rmse",
            "base_repeats": 50,
            "max_enum": 20,
            "q_low": 0.25,
            "q_high": 0.75,
            "random_seed": 42
        },
        "scale": {
            "use_log_error": true,
            "log_base_error": "10",
            "eps_error": 1e-30,
            "use_log_cost": true,
            "log_base_cost": "10",
            "eps_cost": 1e-30,
            "normalize_w_rbar": false
        },
        "plot": {
            "figsize": [10, 4],
            "dpi": 150,
            "xlabel": "Number of curves",
            "ylabel": "Error metric",
            "time_label": "CPU time (s)"
        }
    },
    "pip5_batch_testing": {
        "include_fgpr": true,
        "_include_fgpr_note": "Add normalized-scale and real-scale FGPR combinations to the six baseline combinations.",
        "include_student_t": true,
        "_include_student_t_note": "Add normalized-scale and real-scale Student-t combinations to the testing grid.",
        "run_summary_gpr": true,
        "run_efficiency_eval": true,
        "run_comparison_plots": true,
        "_grid_note": "The baseline grid has six equal/iterative combinations. FGPR and Student-t add two combinations each, for up to ten total."
    }
}
