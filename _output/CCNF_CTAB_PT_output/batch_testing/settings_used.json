{
    "_meta": {
        "version": "2.0",
        "description": "FDA-GPR Pipeline Settings for CCNF_CTAB_PT dataset",
        "author": "Yunkai Sun (C-STEEL, CSE, ANL)",
        "note": "Production settings for CCNF_CTAB_PT chronoamperometry data.",
        "loaded_at": "2026-02-17T10:50:34.586291",
        "input_folder": "./_input\\CCNF_CTAB_PT",
        "saved_at": "2026-02-17T10:58:27.432671",
        "source_file": "./_input\\CCNF_CTAB_PT\\settings_summary_GPR_CCNF_CTAB_PT.json"
    },
    "output_structure": {
        "base_output_dir": "_output",
        "pip2_individual_gpr": "individual_GPR",
        "pip3_scoring_aggregations": "summary_gpr",
        "pip4_efficiency_eval": "learning_curve",
        "pip5_batch_testing": "batch_testing"
    },
    "pip0_dataloading": {
        "file_extension": ".cor",
        "filename_parsing": {
            "delimiter": "_",
            "grouping_keys": [
                {
                    "name": "potential",
                    "token_index": 0,
                    "dtype": "float",
                    "regex_extract": "^([+-]?\\d+\\.?\\d*)V$",
                    "description": "Applied potential in Volts (e.g., -1.95V \u2192 -1.95)"
                }
            ],
            "metadata_keys": [
                {
                    "name": "pH",
                    "token_index": 1,
                    "dtype": "float",
                    "regex_extract": "^pH(\\d+\\.?\\d*)$",
                    "description": "Solution pH value (e.g., pH1.48 \u2192 1.48)"
                },
                {
                    "name": "electrolyte",
                    "token_index": 2,
                    "dtype": "string",
                    "description": "Electrolyte type (e.g., Na2SO4)"
                },
                {
                    "name": "additive",
                    "token_index": 3,
                    "dtype": "string",
                    "description": "Additive compound (e.g., H3Cit)"
                },
                {
                    "name": "alloy",
                    "token_index": 4,
                    "dtype": "string",
                    "description": "Alloy composition (e.g., NiFeCoCu)"
                },
                {
                    "name": "sample_id",
                    "token_index": 6,
                    "dtype": "string",
                    "description": "Sample identifier (e.g., Au-4R2)"
                },
                {
                    "name": "date",
                    "token_index": -1,
                    "dtype": "string",
                    "regex_extract": "^(\\d{8})\\.cor$",
                    "description": "Experiment date YYYYMMDD (e.g., 20230616)"
                }
            ]
        },
        "primary_grouping_key": "potential",
        "fallback_to_file_content": false
    },
    "pip1_datapreprocessing": {
        "column_names": {
            "x_col": "T (Seconds)",
            "y_col": "I (A/cm2)"
        },
        "filtering": {
            "enable_filtering": false,
            "max_points_set": 500,
            "min_x_cap": 0.0001,
            "max_x_cap": 5000.0,
            "min_curve_range": 60.0,
            "y_threshold": 0.01
        },
        "x_scaling": {
            "method": "log",
            "_method_options": [
                "log",
                "identity"
            ],
            "params": {
                "base": "log10",
                "shift": 1e-09
            }
        },
        "y_scaling": {
            "method": "middle_average",
            "_method_options": [
                "peak",
                "middle_average",
                "identity"
            ],
            "params": {
                "start_fraction": 0.5,
                "end_fraction": 0.9
            }
        },
        "grouping": {
            "group_round_digits": 2
        }
    },
    "pip2_individual_gpr": {
        "gpr_params": {
            "n_restarts_optimizer": 5,
            "alpha": 1e-07,
            "normalize_y": true,
            "num_curves_threshold": 50,
            "num_X_pred_points_individual_default": 500,
            "num_X_pred_points_individual_high": 1000
        },
        "shared_grid": {
            "enabled": true,
            "method": "explicit",
            "_method_options": [
                "auto",
                "explicit",
                "per_group"
            ],
            "explicit_grid": "np.linspace(-1.0, 3.69897, 500)",
            "_explicit_grid_note": "Python expression evaluated with numpy (np) available. Upper bound = log10(max_x_cap); 4.0 = log10(1e3 s).",
            "auto_num_points": 500,
            "auto_padding_fraction": 0.0,
            "refit_on_full_data": false,
            "_refit_note": "If true, after hyperparameter tuning on train split, refit GPR on all data with frozen hyperparams before regulating to shared grid."
        },
        "posterior_covariance": {
            "store_full_covariance": true,
            "storage_mode": "full",
            "_storage_mode_options": [
                "full",
                "diagonal",
                "sparse",
                "cholesky"
            ],
            "sparse_threshold": 1e-06
        },
        "kernel": {
            "constant_bounds": [
                0.01,
                10000.0
            ],
            "matern_length_scale": 1.0,
            "matern_length_scale_bounds": [
                0.01,
                1000.0
            ],
            "matern_nu": 1.5,
            "white_noise_level": 1.0,
            "white_noise_bounds": [
                1e-12,
                10.0
            ]
        },
        "export": {
            "plot_individual_gpr": true,
            "individual_curve_alpha": 0.3,
            "plot_downsample_points": 500,
            "dpi": 150,
            "max_points_to_save": 10000
        }
    },
    "pip3_summary_gpr": {
        "file_pattern": "Individual_GPR_*.csv",
        "aggregation": {
            "weight_mode": "equal",
            "_weight_mode_options": [
                "equal",
                "iterative"
            ],
            "weight_scope": "curve",
            "_weight_scope_options": [
                "curve",
                "point"
            ],
            "include_within_variance": true,
            "include_between_variance": true,
            "variance_aggregation_scale": "normalised",
            "_variance_aggregation_scale_options": [
                "real",
                "normalised"
            ],
            "normalization_summary": false,
            "enable_operator_fusion": false,
            "_enable_operator_fusion_note": "Operator fusion is deprecated; kept only for legacy comparison. FGPR is the preferred covariance-aware method.",
            "enable_fgpr": true,
            "_enable_fgpr_note": "Enable FGPR aggregation (precision-weighted inverse-variance pooling with sigma_btw optimisation). Independent of operator fusion.",
            "enable_student_t": true,
            "_enable_student_t_note": "Enable Student-t robust curve aggregation (curvewise EM/IRLS weights with joint sigma_btw fitting). Independent of FGPR.",
            "aggregation_method": "student_t",
            "_aggregation_method_options": [
                "iterative",
                "fgpr",
                "student_t"
            ],
            "_aggregation_method_note": "Default method for standalone pip3. Batch testing (pip5) overrides this per combination."
        },
        "plotting": {
            "plot_individual_gprs": true,
            "individual_curve_alpha": 0.2,
            "min_time_cap": 0.01
        },
        "hyperparams": {
            "max_iterations": null,
            "convergence_tol": 1e-06,
            "epsilon": 1e-12,
            "confidence_level": 0.95,
            "num_interp_points": 500,
            "_num_interp_points_note": "Only used for iterative weight interpolation, not for shared-grid regulated output.",
            "fgpr_min_scale_factor_ratio": 0.0,
            "_fgpr_min_scale_factor_ratio_note": "Exclude curves with |scale_factor| < ratio * median(|scale_factor|). Prevents near-zero factors from corrupting sigma_btw estimation. Set to 0 to disable.",
            "student_t_nu": 5.0,
            "_student_t_nu_note": "Degrees of freedom for Student-t robust aggregation. Small nu = heavy tails (robust); large nu = Gaussian limit.",
            "student_t_max_iterations": 1000,
            "student_t_convergence_tol": 1e-06
        }
    },
    "pip4_efficiency_eval": {
        "global": {
            "metric": "rmse",
            "_metric_options": [
                "rmse",
                "mae",
                "max"
            ],
            "base_repeats": 50,
            "max_enum": 20,
            "q_low": 0.25,
            "q_high": 0.75,
            "random_seed": 42
        },
        "scale": {
            "use_log_error": true,
            "log_base_error": "10",
            "_log_base_options": [
                "10",
                "e"
            ],
            "eps_error": 1e-30,
            "use_log_cost": true,
            "log_base_cost": "10",
            "eps_cost": 1e-30,
            "normalize_w_rbar": false
        },
        "plot": {
            "figsize": [
                10,
                4
            ],
            "dpi": 150,
            "xlabel": "Number of curves",
            "ylabel": "Error metric",
            "time_label": "CPU time (s)"
        }
    },
    "pip5_batch_testing": {
        "include_fgpr": true,
        "_include_fgpr_note": "When true, adds 2 FGPR combinations (normalised + real) to the 6 iterative combinations.",
        "include_student_t": true,
        "_include_student_t_note": "When true, adds 2 Student-t combinations (normalised + real) to the testing grid.",
        "run_summary_gpr": true,
        "run_efficiency_eval": true,
        "run_comparison_plots": true,
        "_grid_note": "The testing grid = {normalization: [true, false]} x {(equal, curve), (iterative, curve), (iterative, point)} = 6 iterative combos. With include_fgpr/include_student_t, adds 2 extra combos each."
    }
}